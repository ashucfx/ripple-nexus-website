# ─── Email (existing) ────────────────────────────────────────────────────────
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@theripplenexus.com
SMTP_PASS=""

# ─── Supabase (PostgreSQL database) ──────────────────────────────────────────
# Create a project at https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key   # NOT the anon key

# ─── Razorpay (India payments) ────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── PayPal (International payments) ─────────────────────────────────────────
# Dashboard: https://developer.paypal.com → My Apps → Create App
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox   # Change to "live" for production

# ─── Google Calendar (Google Meet link generation) ───────────────────────────
# 1. Google Cloud Console → IAM → Service Accounts → Create → Download JSON key
# 2. Share your Google Calendar with the service account email (Editor access)
# 3. Copy values from the downloaded JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=rns-scheduler@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary   # or your-calendar-id@group.calendar.google.com

# ─── Control Plane / Intake Pipeline Access ──────────────────────────────────
ADMIN_PASSWORD=change-this-to-a-strong-password
# Legacy alias: RNS_ADMIN_PASSWORD is also supported

# ─── Site URL (used in PayPal redirect URLs) ─────────────────────────────────
SITE_URL=https://www.theripplenexus.com

# ─── Frontend (VITE_ prefix = exposed to browser bundle) ─────────────────────
# PayPal client ID is safe to expose (public key)
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
